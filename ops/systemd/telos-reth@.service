[Unit]
Description=Telos Reth execution client (%i)
Documentation=https://github.com/telosnetwork/telos-reth-2/blob/main/docs/telos/operations.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=15min
StartLimitBurst=3
ConditionPathIsExecutable=/usr/local/bin/telos-reth
ConditionPathExists=/etc/telos-reth/%i/node.env

[Service]
Type=simple
User=telos-reth
Group=telos-reth
SupplementaryGroups=telos-reth-config
UMask=0027
EnvironmentFile=/etc/telos-reth/%i/node.env
LoadCredential=jwt.hex:/etc/telos-reth/%i/jwt.hex
LoadCredential=signer.key:/etc/telos-reth/%i/signer.key
# A non-secret disabled marker makes transaction forwarding explicitly optional. Preflight rejects
# partial configurations, and a real LoadCredential value takes precedence over this fallback.
SetCredential=signer.key:disabled
StateDirectory=telos-reth/%i
StateDirectoryMode=0750
RuntimeDirectory=telos-reth/%i
RuntimeDirectoryMode=0750

ExecStartPre=+/usr/local/libexec/telos-reth-preflight %i %d/jwt.hex %d/signer.key
ExecStart=/usr/local/libexec/telos-reth-run %i %d/jwt.hex %d/signer.key

Restart=on-failure
RestartSec=10s
TimeoutStartSec=5min
TimeoutStopSec=5min
KillSignal=SIGINT
LimitNOFILE=1048576
TasksMax=65536
MemoryHigh=85%
MemoryMax=90%
MemorySwapMax=0
OOMScoreAdjust=-500

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/etc/telos-reth
ReadWritePaths=/var/lib/telos-reth/%i /run/telos-reth/%i

StandardOutput=journal
StandardError=journal
SyslogIdentifier=telos-reth-%i

[Install]
WantedBy=multi-user.target
