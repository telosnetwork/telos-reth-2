[Unit]
Description=Telos retained-history execution backend (%i)
Documentation=https://github.com/telosnetwork/telos-reth-2/blob/main/docs/telos/history-routing.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=15min
StartLimitBurst=3
ConditionPathExists=/etc/telos-reth/%i/archive.env
ConditionPathExists=/etc/telos-reth/%i/archive-jwt.hex

[Service]
Type=exec
User=telos-reth-archive
Group=telos-reth-archive
SupplementaryGroups=telos-reth-config
UMask=0077
EnvironmentFile=/etc/telos-reth/%i/archive.env
LoadCredential=archive-jwt.hex:/etc/telos-reth/%i/archive-jwt.hex
StateDirectory=telos-reth-archive/%i
StateDirectoryMode=0700
ExecStart=/usr/local/libexec/telos-reth-archive-run %i %d/archive-jwt.hex

Restart=on-failure
RestartSec=10s
TimeoutStartSec=5min
TimeoutStopSec=5min
KillSignal=SIGINT
LimitNOFILE=1048576
TasksMax=65536
MemoryHigh=85%
MemoryMax=90%
MemorySwapMax=0
OOMScoreAdjust=300

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=localhost
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/etc/telos-reth
ReadWritePaths=/var/lib/telos-reth-archive/%i

StandardOutput=journal
StandardError=journal
SyslogIdentifier=telos-reth-archive-%i

[Install]
WantedBy=multi-user.target
