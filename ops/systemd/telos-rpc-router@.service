[Unit]
Description=Telos retained-history JSON-RPC router (%i)
Documentation=https://github.com/telosnetwork/telos-reth-2/blob/main/docs/telos/history-routing.md
Wants=network-online.target
After=network-online.target telos-reth@%i.service
Requires=telos-reth@%i.service
StartLimitIntervalSec=15min
StartLimitBurst=6
ConditionFileIsExecutable=/usr/local/bin/telos-rpc-router
ConditionPathExists=/etc/telos-reth/%i/router.env

[Service]
Type=exec
User=telos-rpc-router
Group=telos-rpc-router
SupplementaryGroups=telos-reth-config
UMask=0077
EnvironmentFile=/etc/telos-reth/%i/router.env
Environment=RUST_BACKTRACE=0
ExecStartPre=/usr/local/libexec/telos-rpc-router-preflight %i
ExecStart=/usr/local/bin/telos-rpc-router

Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGINT
LimitNOFILE=16384
TasksMax=1024
MemoryHigh=1536M
MemoryMax=2G
MemorySwapMax=0

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=localhost
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/etc/telos-reth

StandardOutput=journal
StandardError=journal
SyslogIdentifier=telos-rpc-router-%i

[Install]
WantedBy=multi-user.target
