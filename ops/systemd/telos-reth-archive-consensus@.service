[Unit]
Description=Telos retained-history consensus companion (%i)
Documentation=https://github.com/telosnetwork/telos-reth-2/blob/main/docs/telos/history-routing.md
Requires=telos-reth-archive@%i.service
After=network-online.target telos-reth-archive@%i.service
Wants=network-online.target
StartLimitIntervalSec=15min
StartLimitBurst=3
ConditionPathExists=/etc/telos-reth/%i/archive-consensus.toml

[Service]
Type=exec
User=telos-reth-archive-consensus
Group=telos-reth-archive-consensus
SupplementaryGroups=telos-reth-config
UMask=0077
EnvironmentFile=/etc/telos-reth/%i/archive.env
LoadCredential=archive-jwt.hex:/etc/telos-reth/%i/archive-jwt.hex
StateDirectory=telos-reth-archive-consensus/%i
StateDirectoryMode=0700
RuntimeDirectory=telos-reth-archive-consensus-%i
RuntimeDirectoryMode=0700
ExecStart=/usr/local/libexec/telos-reth-archive-consensus-run %i %d/archive-jwt.hex

Restart=on-failure
RestartSec=10s
TimeoutStartSec=5min
TimeoutStopSec=5min
KillSignal=SIGINT
LimitNOFILE=262144
TasksMax=8192
MemoryHigh=4G
MemoryMax=6G
MemorySwapMax=0
OOMScoreAdjust=400

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=localhost
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/etc/telos-reth
ReadWritePaths=/var/lib/telos-reth-archive-consensus/%i

StandardOutput=journal
StandardError=journal
SyslogIdentifier=telos-reth-archive-consensus-%i

[Install]
WantedBy=multi-user.target
