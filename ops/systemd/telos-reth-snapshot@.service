[Unit]
Description=Atomic Telos Reth recovery point and remote backup (%i)
Documentation=https://github.com/telosnetwork/telos-reth-2/blob/main/docs/telos/operations.md
RequiresMountsFor=/var/lib/telos-reth/%i /var/lib/telos-consensus/%i /var/lib/telos-reth-snapshots
After=network-online.target telos-reth@%i.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/telos-reth/%i/node.env
Environment=RESTIC_CACHE_DIR=/var/cache/telos-reth-backup/%i
StateDirectory=telos-reth-backup/%i
StateDirectoryMode=0700
CacheDirectory=telos-reth-backup/%i
CacheDirectoryMode=0700
LoadCredential=restic.repository:/etc/telos-reth/%i/restic.repository
LoadCredential=restic.password:/etc/telos-reth/%i/restic.password
ExecStart=/usr/local/libexec/telos-reth-snapshot %i %d/restic.repository %d/restic.password
TimeoutStartSec=infinity
Nice=10
IOSchedulingClass=idle
CPUWeight=20
IOWeight=20
MemoryMax=2G
TasksMax=4096

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
ReadOnlyPaths=/etc/telos-reth /var/lib/telos-reth/%i /var/lib/telos-consensus/%i
ReadWritePaths=/var/lib/telos-reth-snapshots /var/lib/telos-reth-backup /var/lib/telos-reth-health/metrics /var/cache/telos-reth-backup

[Install]
WantedBy=multi-user.target
