#!/usr/bin/env bash
set -euo pipefail

die() {
    echo "telos-reth preflight: $*" >&2
    exit 1
}

[[ $# -eq 3 ]] || die "usage: $0 INSTANCE JWT_CREDENTIAL SIGNER_CREDENTIAL"
instance=$1
jwt_file=$2
signer_file=$3
config=/etc/telos-reth/${instance}/node.env
binary=/usr/local/bin/telos-reth
data_dir=/var/lib/telos-reth/${instance}

[[ $instance =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || die "invalid instance name"
[[ -f $config && ! -L $config ]] || die "$config must be a regular file"
[[ $(stat -c '%U:%G' "$config") == root:root ]] || die "$config must be owned by root:root"
config_mode=$(stat -c '%a' "$config")
(( (8#$config_mode & 8#022) == 0 )) || die "$config must not be group/world writable"

# The file is root-controlled and is consumed by systemd as an EnvironmentFile as well.
# shellcheck disable=SC1090
source "$config"

required=(
    CHAIN CHAIN_ID TELOS_ENDPOINT TELOS_SIGNER_ACCOUNT TELOS_SIGNER_PERMISSION
    HTTP_PORT HTTP_API RPC_MAX_CONNECTIONS RPC_MAX_REQUEST_SIZE_MB RPC_MAX_RESPONSE_SIZE_MB
    AUTHRPC_PORT METRICS_PORT P2P_PORT REFERENCE_RPC_URL NODEOS_URL NODEOS_CHAIN_ID
    CONSENSUS_UNIT CONSENSUS_BINARY CONSENSUS_VERSION CONSENSUS_SHA256 MAX_HEAD_LAG_BLOCKS
    MAX_FINALIZED_STALL_SECONDS MAX_NODEOS_HEAD_AGE_SECONDS PARITY_DEPTHS BINARY_SHA256
)
for name in "${required[@]}"; do
    [[ -n ${!name:-} ]] || die "$name is required in $config"
    [[ ${!name} != REPLACE_* ]] || die "$name still contains a placeholder"
done

[[ $CHAIN_ID =~ ^[0-9]+$ ]] || die "CHAIN_ID must be decimal"
[[ $NODEOS_CHAIN_ID =~ ^[[:xdigit:]]{64}$ ]] || die "NODEOS_CHAIN_ID must be 64 hexadecimal characters"
[[ $BINARY_SHA256 =~ ^[[:xdigit:]]{64}$ ]] || die "BINARY_SHA256 must be 64 hexadecimal characters"
[[ $CONSENSUS_SHA256 =~ ^[[:xdigit:]]{64}$ ]] || die "CONSENSUS_SHA256 must be 64 hexadecimal characters"
[[ $REFERENCE_RPC_URL == https://* ]] || die "REFERENCE_RPC_URL must use HTTPS"
[[ $TELOS_ENDPOINT == http://127.0.0.1:* || $TELOS_ENDPOINT == http://localhost:* || $TELOS_ENDPOINT == https://* ]] ||
    die "TELOS_ENDPOINT must be loopback HTTP or HTTPS"
[[ $NODEOS_URL == http://127.0.0.1:* || $NODEOS_URL == http://localhost:* || $NODEOS_URL == https://* ]] ||
    die "NODEOS_URL must be loopback HTTP or HTTPS"

for name in HTTP_PORT AUTHRPC_PORT METRICS_PORT P2P_PORT; do
    value=${!name}
    [[ $value =~ ^[0-9]+$ ]] && (( value >= 1024 && value <= 65535 )) || die "$name is outside 1024..65535"
done
[[ $HTTP_PORT != "$AUTHRPC_PORT" && $HTTP_PORT != "$METRICS_PORT" && $AUTHRPC_PORT != "$METRICS_PORT" ]] ||
    die "HTTP, Engine, and metrics ports must be distinct"

[[ -x $binary && ! -L $binary ]] || {
    # An atomic release symlink is expected; resolve it before applying ownership checks.
    binary=$(readlink -f "$binary")
    [[ -x $binary && -f $binary ]] || die "/usr/local/bin/telos-reth does not resolve to an executable"
}
[[ $(stat -c '%U' "$binary") == root ]] || die "$binary must be owned by root"
binary_mode=$(stat -c '%a' "$binary")
(( (8#$binary_mode & 8#022) == 0 )) || die "$binary must not be group/world writable"
actual_digest=$(sha256sum "$binary" | awk '{print $1}')
[[ ${actual_digest,,} == ${BINARY_SHA256,,} ]] || die "binary digest does not match the approved release"

[[ -x $CONSENSUS_BINARY && -f $CONSENSUS_BINARY && ! -L $CONSENSUS_BINARY ]] || {
    CONSENSUS_BINARY=$(readlink -f "$CONSENSUS_BINARY")
    [[ -x $CONSENSUS_BINARY && -f $CONSENSUS_BINARY ]] || die "consensus binary is unavailable"
}
[[ $(stat -c '%U' "$CONSENSUS_BINARY") == root ]] || die "$CONSENSUS_BINARY must be owned by root"
consensus_mode=$(stat -c '%a' "$CONSENSUS_BINARY")
(( (8#$consensus_mode & 8#022) == 0 )) || die "$CONSENSUS_BINARY must not be group/world writable"
actual_consensus_digest=$(sha256sum "$CONSENSUS_BINARY" | awk '{print $1}')
[[ ${actual_consensus_digest,,} == ${CONSENSUS_SHA256,,} ]] || die "consensus binary digest is not approved"
actual_consensus_version=$($CONSENSUS_BINARY --version | head -n 1)
[[ $actual_consensus_version == "$CONSENSUS_VERSION" ]] ||
    die "consensus version mismatch: expected '$CONSENSUS_VERSION', got '$actual_consensus_version'"

[[ -d $data_dir && ! -L $data_dir ]] || die "$data_dir must be a directory"
[[ $(stat -c '%U:%G' "$data_dir") == telos-reth:telos-reth ]] || die "$data_dir must be owned by telos-reth:telos-reth"

[[ -f $jwt_file && -r $jwt_file ]] || die "JWT systemd credential is unavailable"
jwt=$(tr -d '\r\n' < "$jwt_file")
[[ $jwt =~ ^[[:xdigit:]]{64}$ ]] || die "JWT must contain exactly 32 bytes encoded as hexadecimal"

[[ -f $signer_file && -r $signer_file ]] || die "signer systemd credential is unavailable"
signer=$(tr -d '\r\n' < "$signer_file")
[[ -n $signer && ${#signer} -le 256 && $signer != *[[:space:]]* ]] || die "signer credential is malformed"

exec "$binary" --version >/dev/null
