# Install as /etc/telos-reth/mainnet/archive.env, owned by root:telos-reth-config and mode 0440.
# The retained backend is a separately copied database and process. Never point ARCHIVE_DATADIR at
# the incumbent's live directory, and never reuse its JWT or discovery secret.
ARCHIVE_BINARY=/usr/local/lib/telos-reth-archive/releases/REPLACE_WITH_VERSION/telos-reth
ARCHIVE_BINARY_SHA256=REPLACE_WITH_64_HEX_LEGACY_ARCHIVE_BINARY_DIGEST
ARCHIVE_DATADIR=/var/lib/telos-reth-archive/mainnet
ARCHIVE_CHAIN=tevmmainnet
ARCHIVE_CHAIN_ID=40
ARCHIVE_HTTP_PORT=28545
ARCHIVE_AUTHRPC_PORT=28551
ARCHIVE_P2P_PORT=28338
ARCHIVE_METRICS_PORT=29002
ARCHIVE_HTTP_API=admin,debug,eth,net,ots,reth,rpc,trace,txpool,web3

# The companion must be the same independently qualified artifact used by the live v2 node. Its
# reviewed archive-consensus.toml uses the archive Engine port and its own state directory.
ARCHIVE_CONSENSUS_BINARY=/usr/local/bin/telos-consensus-client
ARCHIVE_CONSENSUS_BINARY_SHA256=REPLACE_WITH_64_HEX_COMPANION_DIGEST
ARCHIVE_CONSENSUS_CONFIG=/etc/telos-reth/mainnet/archive-consensus.toml
