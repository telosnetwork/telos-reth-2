# Install as /etc/telos-reth/mainnet/archive.env, owned by root:telos-reth-config and mode 0440.
# The retained backend is a separately copied database and process. Never point ARCHIVE_DATADIR at
# the incumbent's live directory, and never reuse its JWT or discovery secret.
ARCHIVE_BINARY=/usr/local/lib/telos-reth-archive/releases/REPLACE_WITH_VERSION/telos-reth
ARCHIVE_BINARY_SHA256=REPLACE_WITH_64_HEX_LEGACY_ARCHIVE_BINARY_DIGEST
ARCHIVE_DATADIR=/var/lib/telos-reth-archive/mainnet
ARCHIVE_CHAIN=tevmmainnet
ARCHIVE_CHAIN_ID=40
ARCHIVE_HTTP_PORT=28545
ARCHIVE_AUTHRPC_PORT=28551
ARCHIVE_P2P_PORT=28338
ARCHIVE_METRICS_PORT=29002
ARCHIVE_HTTP_API=admin,debug,eth,net,ots,reth,rpc,trace,txpool,web3

# The retained legacy execution binary requires its matching, independently qualified companion;
# it is intentionally distinct from the live v2 companion. Record all three anchor values in the
# immutable copy manifest. START_BLOCK is the copied archive head plus one, PREV_HASH is the copied
# archive head hash, and VALIDATE_HASH is that next block's canonical hash.
ARCHIVE_CONSENSUS_BINARY=/usr/local/lib/telos-reth-archive-consensus/releases/REPLACE_WITH_VERSION/telos-consensus-client
ARCHIVE_CONSENSUS_BINARY_SHA256=REPLACE_WITH_64_HEX_MATCHING_LEGACY_COMPANION_DIGEST
ARCHIVE_CONSENSUS_CONFIG=/etc/telos-reth/mainnet/archive-consensus.toml
ARCHIVE_CONSENSUS_EVM_START_BLOCK=REPLACE_WITH_SNAPSHOT_HEAD_PLUS_ONE
ARCHIVE_CONSENSUS_PREV_HASH=REPLACE_WITH_0X64_HEX_SNAPSHOT_HEAD_HASH
ARCHIVE_CONSENSUS_VALIDATE_HASH=REPLACE_WITH_0X64_HEX_NEXT_BLOCK_HASH
