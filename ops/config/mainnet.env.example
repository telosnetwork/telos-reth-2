# Install as /etc/telos-reth/mainnet/node.env, owned by root:telos-reth-config and mode 0440.
CHAIN=telos-checkpoint:/etc/telos-reth/mainnet/checkpoint.json
CHAIN_ID=40
CHECKPOINT_MANIFEST=/etc/telos-reth/mainnet/checkpoint.json
CHECKPOINT_MANIFEST_SHA256=REPLACE_WITH_64_HEX_CHECKPOINT_MANIFEST_DIGEST
CHECKPOINT_AUDIT=/etc/telos-reth/mainnet/checkpoint.audit.json
EXECUTION_ANCHOR=/etc/telos-reth/mainnet/checkpoint.anchor.json
EXECUTION_ANCHOR_BLOCK_NUMBER=REPLACE_WITH_DECIMAL_ANCHOR_HEIGHT
EXECUTION_ANCHOR_BLOCK_HASH=REPLACE_WITH_0X_PREFIXED_ANCHOR_HASH
TELOS_ENDPOINT=http://127.0.0.1:8888
# These empty defaults and an omitted signer.key produce a read-only/shadow RPC. For forwarding,
# replace both values and install signer.key; supplying only part of that set fails preflight.
TELOS_SIGNER_ACCOUNT=
TELOS_SIGNER_PERMISSION=

# Public JSON-RPC stays on loopback. Put a rate-limited TLS proxy in front of it.
HTTP_PORT=8545
HTTP_API=eth,net,web3
# WebSocket RPC is disabled by default. When enabled it remains loopback-only and uses the same
# production namespace allowlist.
WS_ENABLED=false
WS_PORT=8546
WS_API=eth,net,web3
RPC_MAX_CONNECTIONS=500
RPC_MAX_REQUEST_SIZE_MB=15
RPC_MAX_RESPONSE_SIZE_MB=64

# The Engine API and metrics endpoint must never be exposed outside the host.
AUTHRPC_PORT=8551
METRICS_PORT=9001

# Readiness uses independent authoritative endpoints and fails closed when either is unavailable.
REFERENCE_RPC_URL=https://rpc.telos.net/evm
NODEOS_URL=http://127.0.0.1:8888
NODEOS_CHAIN_ID=4667b205c6838ef70ff7988f6e8257e8be0e1284a2f59699054a018f743b1d11
CONSENSUS_UNIT=telos-consensus-client@mainnet.service
CONSENSUS_BINARY=/usr/local/bin/telos-consensus-client
CONSENSUS_CONFIG=/etc/telos-reth/mainnet/consensus.toml
CONSENSUS_VERSION="REPLACE_WITH_EXACT_VERSION_OUTPUT"
CONSENSUS_SHA256=REPLACE_WITH_64_HEX_COMPANION_DIGEST
MAX_HEAD_LAG_BLOCKS=4
MAX_FINALIZED_STALL_SECONDS=180
MAX_NODEOS_HEAD_AGE_SECONDS=30
PARITY_DEPTHS=0,64,512

# Pin every deployment to the digest published with the approved release.
BINARY_SHA256=REPLACE_WITH_64_HEX_RELEASE_DIGEST
