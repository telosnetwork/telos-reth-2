# Install as /etc/telos-reth/mainnet/router.env, owned by root:telos-reth-config and mode 0440.
#
# The retained incumbent stays on its existing loopback listener. The sparse v2 node must use a
# different listener (18545 in this example), and the external TLS proxy may use only the router
# listener. TELOS_RPC_ROUTER_ARCHIVE_URL is the binary's compatibility name for the retained
# incumbent; this topology is not a standalone full archive.
TELOS_RPC_ROUTER_BINARY_SHA256=REPLACE_WITH_64_HEX_RELEASE_ROUTER_DIGEST
TELOS_RPC_ROUTER_LISTEN=127.0.0.1:8645
TELOS_RPC_ROUTER_LIVE_URL=http://127.0.0.1:18545/
TELOS_RPC_ROUTER_ARCHIVE_URL=http://127.0.0.1:8545/

# The sparse database's first retained EVM block and its exact canonical hash. Readiness requires
# both backends to agree at this boundary.
TELOS_RPC_ROUTER_LIVE_HISTORY_START=479294328
TELOS_RPC_ROUTER_CHAIN_ID=40
TELOS_RPC_ROUTER_ANCHOR_HASH=0x7d62876c8248867708f934b13184ff03440c2b4447a0434562c10bbc783bef51

# This retained pre-Savanna EVM block proves that the incumbent still serves history below the
# sparse boundary. The account, balance, receipt, and empty log result are exact historical-state
# witnesses at that block. It is native block 423015053 minus the authenticated native/EVM delta
# of 36.
TELOS_RPC_ROUTER_HISTORY_PROBE_NUMBER=423015017
TELOS_RPC_ROUTER_HISTORY_PROBE_HASH=0x9af24c613ebf3ba3cbd8a29d9b4c24a0cf5589544a162dfe66c98f25a1ce55c0
TELOS_RPC_ROUTER_HISTORY_PROBE_ADDRESS=0x1a7883121285dfe08fb89763d084d5c7966dcf92
TELOS_RPC_ROUTER_HISTORY_PROBE_BALANCE=0x23b0c973e84998e4f
TELOS_RPC_ROUTER_HISTORY_PROBE_TRANSACTION_HASH=0x411b585bf0b052f527b1924f500686d4b7c7cab9da18f81cbacfa4405bd15819

TELOS_RPC_ROUTER_MAX_HEAD_LAG=4
TELOS_RPC_ROUTER_MAX_REQUEST_BYTES=15728640
TELOS_RPC_ROUTER_MAX_RESPONSE_BYTES=67108864
TELOS_RPC_ROUTER_MAX_BATCH_LEN=64
TELOS_RPC_ROUTER_MAX_CONNECTIONS=256
TELOS_RPC_ROUTER_MAX_INFLIGHT=16
TELOS_RPC_ROUTER_REQUEST_TIMEOUT_MS=30000
TELOS_RPC_ROUTER_BACKEND_TIMEOUT_MS=30000
RUST_LOG=telos_rpc_router=info
