# Install as /etc/telos-reth/<instance>/backup.env, root:root 0640.
# The execution and consensus directories form one recovery point and are always stopped together.
CONSENSUS_DATA_DIR=/var/lib/telos-consensus/REPLACE_WITH_INSTANCE
CONSENSUS_UNIT=telos-consensus-client@REPLACE_WITH_INSTANCE.service
# Staging must be on the same reflink-capable filesystem as both data directories.
SNAPSHOT_ROOT=/var/lib/telos-reth-snapshots
LOCAL_KEEP=3

# A remote restic copy is mandatory. The repository URL and password are supplied through
# systemd credentials, not this environment file. Prefer workload identity for backend access.
RESTIC_TAG=telos-production
RESTORE_HEALTH_TIMEOUT_SECONDS=900
